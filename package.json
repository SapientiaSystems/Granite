{
    "name": "granite",
    "private": true,
    "scripts": {
        "remote-registry-config": "yarn config set registry https://registry.npmjs.org/",
        "local-registry-install": "yarn global add verdaccio",
        "local-registry-config": "yarn config set registry http://localhost:4873/",
        "local-registry-start": "verdaccio",
        "local-registry-init": "yarn run local-registry-install && yarn run local-registry-start && yarn run local-registry-config",
        "dev-init": "yarn --dev install",
        "clean-granite-user": "cd Microservices/Granite.User && yarn run clean",
        "clean-granite-session": "cd Microservices/Granite.Session && yarn run clean",
        "clean-granite-feedback": "cd Microservices/Granite.Feedback && yarn run clean",
        "clean-granite-survey": "cd Microservices/Granite.Survey && yarn run clean",
        "clean-granite-frontendcontroller": "cd Microservices/Granite.FrontEndController && yarn run clean",
        "clean-microservices": "yarn run clean-granite-user && yarn run clean-granite-session && yarn run clean-granite-feedback && yarn run clean-granite-survey && yarn run clean-granite-frontendcontroller",
        "clean-granite-web": "cd FrontEnds/Granite.Web && yarn run clean",
        "clean-frontends": "yarn run clean-granite-web",
        "clean": "yarn run dev-init && yarn run clean-microservices && yarn run clean-frontends",
        "deep-clean-granite-user": "cd Microservices/Granite.User && yarn run deep-clean",
        "deep-clean-granite-session": "cd Microservices/Granite.Session && yarn run deep-clean",
        "deep-clean-granite-feedback": "cd Microservices/Granite.Feedback && yarn run deep-clean",
        "deep-clean-granite-survey": "cd Microservices/Granite.Survey && yarn run deep-clean",
        "deep-clean-granite-frontendcontroller": "cd Microservices/Granite.FrontEndController && yarn run deep-clean",
        "deep-clean-microservices": "yarn run deep-clean-granite-user && yarn run deep-clean-granite-session && yarn run deep-clean-granite-feedback && yarn run deep-clean-granite-survey && yarn run deep-clean-granite-frontendcontroller",
        "deep-clean-granite-web": "cd FrontEnds/Granite.Web && yarn run deep-clean",
        "deep-clean-frontends": "yarn run deep-clean-granite-web",
        "deep-clean": "yarn run dev-init && yarn run deep-clean-microservices && yarn run deep-clean-frontends",
        "build-granite-user": "cd Microservices/Granite.User && yarn run build",
        "build-granite-session": "cd Microservices/Granite.Session && yarn run build",
        "build-granite-feedback": "cd Microservices/Granite.Feedback && yarn run build",
        "build-granite-survey": "cd Microservices/Granite.Survey && yarn run build",
        "build-granite-frontendcontroller": "cd Microservices/Granite.FrontEndController && yarn run build",
        "build-microservices": "yarn run build-granite-user && yarn run build-granite-session && yarn run build-granite-feedback && yarn run build-granite-survey && yarn run build-granite-frontendcontroller",
        "build-granite-web": "cd FrontEnds/Granite.Web && yarn run build",
        "build-frontends": "yarn run build-granite-web",
        "build": "yarn run dev-init && yarn run build-microservices && yarn run build-frontends",
        "containerize-granite-web": "cd FrontEnds/Granite.Web && yarn run containerize-granite-web-apphost",
        "push-granite-web": "cd FrontEnds/Granite.Web && yarn run push-granite-web-apphost",
        "test-granite-web": "cd FrontEnds/Granite.Web && yarn run test-granite-web",
        "test-granite": "yarn run test-granite-web",
        "test": "yarn run build"
    },
    "devDependencies": {
        "del-cli": "^5.1.0"
    },
    "version": "0.0.0"
}
