<project 
    name="IdentityManager" 
    default="run-commit-stage" 
    basedir=".">

	
    <!-- root directories -->
    <property name="workspace.root" value="${basedir}"/>
    <property name="applications.root" value="${basedir}/applications"/>
    <property name="components.root" value="${basedir}/components"/>
    <property name="tests.root" value="${basedir}/tests"/>
    
    <property name="server.root" value="${applications.root}/IdentityManagerServer"/>
    <property name="batch.root" value="${applications.root}/IdentityManagerBatch"/>

    <property name="common.root" value="${components.root}/IdentityManagerCommon"/>
    <property name="service.root" value="${components.root}/IdentityManagerService"/>
    <property name="integration.root" value="${components.root}/IdentityManagerIntegration"/>
    <property name="application.root" value="${components.root}/IdentityManagerApplication"/>
    <property name="domain.root" value="${components.root}/IdentityManagerDomain"/>
    <property name="clientplatform.root" value="${components.root}/IdentityManagerClientPlatform"/>
    <property name="serverplatform.root" value="${components.root}/IdentityManagerServerPlatform"/>

    <property name="commontest.root" value="${tests.root}/IdentityManagerCommonTest"/>
    <property name="servicetest.root" value="${tests.root}/IdentityManagerServiceTest"/>
    <property name="integrationtest.root" value="${tests.root}/IdentityManagerIntegrationTest"/>
    <property name="applicationtest.root" value="${tests.root}/IdentityManagerApplicationTest"/>
    <property name="domaintest.root" value="${tests.root}/IdentityManagerDomainTest"/>
    <property name="clientplatformtest.root" value="${tests.root}/IdentityManagerClientPlatformTest"/>
    <property name="serverplatformtest.root" value="${tests.root}/IdentityManagerServerPlatformTest"/>
    <property name="testsuite.root" value="${tests.root}/IdentityManagerTestSuite"/>
    
    <filelist id="build.files">
        <file name="${common.root}/build.xml"/>
        <file name="${commontest.root}/build.xml"/>
        
        <file name="${service.root}/build.xml"/>
        <file name="${servicetest.root}/build.xml"/>
        
        <file name="${integration.root}/build.xml"/>
        <file name="${integrationtest.root}/build.xml"/>
        
        <file name="${domain.root}/build.xml"/>
        <file name="${domaintest.root}/build.xml"/>
                
        <file name="${application.root}/build.xml"/>
        <file name="${applicationtest.root}/build.xml"/>
                
        <file name="${clientplatform.root}/build.xml"/>
        <file name="${clientplatformtest.root}/build.xml"/>
                
        <file name="${serverplatform.root}/build.xml"/>
        <file name="${serverplatformtest.root}/build.xml"/>
                
        <file name="${testsuite.root}/build.xml"/>

        <file name="${server.root}/build.xml"/>
        <file name="${batch.root}/build.xml"/>
        
    </filelist>
        
 	<macrodef 
 	    name="iterate">
        <attribute name="target"/>
        <sequential>
        	<subant target="@{target}">
            	<filelist refid="build.files"/>
            </subant>
        </sequential>
    </macrodef>

    <target name="clean">
    	<iterate target="clean"/>
    </target>
 	
    <target name="run-commit-stage">
    	<iterate target="run-commit-stage"/>
    </target>
    
    <target name="run-integration-stage">
    	<iterate target="run-integration-stage"/>
    </target>
    
    <target name="install-to-local-repository">
    	<iterate target="install-to-local-repository"/>
    </target>
 	
 	<target name="deploy-to-remote-repository">
    	<iterate target="deploy-to-remote-repository"/>
    </target>
    
 </project>