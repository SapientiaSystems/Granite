<project 
	xmlns:artifact="antlib:org.apache.maven.artifact.ant"
	name="IdentityManagerService" 
	default="run-commit-stage">
	
	<import file="../../component-targets.xml"/>
	
	<target name="define-properties">
		
	    <property name="source.dir" value="src"/>
	    <property name="output.dir" value="bin"/>
	    <property name="distribution.dir" value="lib"/>
	    <property name="artifact.name" value="${ant.project.name}-${version}"/>
	    <property name="component.artifact" value="${distribution.dir}/${artifact.name}.jar"/>
		
		<property name="schema.dir" value="../../../xsd/IdentityManagerService"/>
		<property name="generated.dir" value="generated"/>
		<property name="generated.package" value="identitymanager.service.authentication"/>
		
		<artifact:pom 
			name="IdentityManager Service Component"
			id="${ant.project.name}" 
			groupId="identitymanager" 
			artifactId="${ant.project.name}" 
			version="${version}">
	        <dependency groupId="identitymanager" artifactId="IdentityManagerCommon" version="${version}"/>
		</artifact:pom>
			
	    <artifact:dependencies 
	    	pathId="dependency.classpath"
	    	pomRefId="${ant.project.name}">
	        <localRepository path="${repository.dir}"/>
	    </artifact:dependencies>
		
		<property name="component.classpath" value="dependency.classpath"/>
				
	</target>

	<target 
		name="generate-transfer-objects"
		depends="define-properties">
		<mkdir dir="${generated.dir}"/>
		<java classname="com.sun.tools.internal.xjc.XJCFacade"> 
		    <arg value="-d"/>
			<arg value="${generated.dir}"/>
			<arg value="-episode"/>
		    <arg value="Shared.episode"/>
		    <arg value="-p"/>
		    <arg value="identitymanager.service.shared"/>
		    <arg value="${schema.dir}/SharedSchema.xsd"/>
		</java>	
		<java classname="com.sun.tools.internal.xjc.XJCFacade"> 
		    <arg value="-d"/>
		    <arg value="${generated.dir}"/>
			<arg value="-extension"/>
			<arg value="-b"/>
			<arg value="Shared.episode"/>
		    <arg value="-p"/>
		    <arg value="identitymanager.service.authentication"/>
		    <arg value="${schema.dir}/AuthenticationSchema.xsd"/>
		</java>
		<java classname="com.sun.tools.internal.xjc.XJCFacade"> 
		    <arg value="-d"/>
		    <arg value="${generated.dir}"/>
			<arg value="-extension"/>
			<arg value="-b"/>
			<arg value="Shared.episode"/>
		    <arg value="-p"/>
		    <arg value="identitymanager.service.useridentity"/>
		    <arg value="${schema.dir}/UserIdentitySchema.xsd"/>
		</java>
		<!--
		<java classname="com.sun.tools.internal.xjc.XJCFacade"> 
		    <arg value="-d"/>
		    <arg value="${generated.dir}"/>
			<arg value="-extension"/>
			<arg value="-b"/>
			<arg value="Shared.episode"/>
		    <arg value="-p"/>
		    <arg value="identitymanager.service.payment"/>
		    <arg value="${schema.dir}/PaymentSchema.xsd"/>
		</java>
		-->
	</target>
	
</project>	