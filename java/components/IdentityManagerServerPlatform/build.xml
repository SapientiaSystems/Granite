<project 
	xmlns:artifact="antlib:org.apache.maven.artifact.ant"
	name="IdentityManagerServerPlatform" 
	default="run-commit-stage">
	
	<import file="../../component-targets.xml"/>
	
	<target name="define-properties">
		
	    <property name="source.dir" value="src"/>
	    <property name="output.dir" value="bin"/>
	    <property name="distribution.dir" value="lib"/>
	    <property name="artifact.name" value="${ant.project.name}-${version}"/>
	    <property name="component.artifact" value="${distribution.dir}/${artifact.name}.jar"/>
		
		<artifact:pom 
			name="IdentityManager ServerPlatform Component"
			id="${ant.project.name}" 
			groupId="identitymanager" 
			artifactId="${ant.project.name}" 
			version="${version}">
	        <dependency groupId="identitymanager" artifactId="IdentityManagerIntegration" version="${version}"/>
	        <dependency groupId="identitymanager" artifactId="IdentityManagerApplication" version="${version}"/>
	        <dependency groupId="identitymanager" artifactId="IdentityManagerDomain" version="${version}"/>
	        <dependency groupId="strata1" artifactId="StrataJmsIntegrator" version="${strata.version}"/>
	        <dependency groupId="net.authorize" artifactId="anet-java-sdk" version="1.8.3"/>
	        <dependency groupId="javax.mail" artifactId="mail" version="1.4.7"/>
	        <dependency groupId="org.apache.activemq" artifactId="activemq-all" version="5.9.1"/>
	        <dependency groupId="org.fusesource.stompjms" artifactId="stompjms-client" version="1.19"/>
	        <dependency groupId="org.fusesource.hawtdispatch" artifactId="hawtdispatch" version="1.20"/>
	        <dependency groupId="org.fusesource.hawtdispatch" artifactId="hawtdispatch-transport" version="1.20"/>
		</artifact:pom>
			
	    <artifact:dependencies 
	    	pathId="dependency.classpath"
	    	pomRefId="${ant.project.name}">
	        <localRepository path="${repository.dir}"/>
	    </artifact:dependencies>
		
		<property name="component.classpath" value="dependency.classpath"/>
				
	</target>

</project>	