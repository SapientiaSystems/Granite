<?xml version="1.0" encoding="UTF-8"?>
<schema
	id="GeneratedAuthenticationTypes" 
	xmlns="http://www.w3.org/2001/XMLSchema" 
	targetNamespace="http://IdentityManager.Service.Authentication"
	xmlns:Authentication="http://IdentityManager.Service.Authentication" 
	elementFormDefault="qualified">

	<element name="Request" type="Authentication:AuthenticateRequest"/>
	<element name="Reply" type="Authentication:AuthenticateReply"/>
	
    <complexType name="AuthenticateRequest" abstract="true">
		<sequence>
			<element name="RequestId" type="string"></element>
			<element name="Duplicate" type="boolean"></element>
			<element name="Timestamp" type="dateTime" minOccurs="0" maxOccurs="1"></element>
		</sequence>
	</complexType>
    
    <complexType name="AuthenticateReply">
		<sequence>
			<element name="ReplyId" type="string"></element>
			<element name="OriginatingRequestId" type="string"></element>
			<element name="Duplicate" type="boolean"></element>
			<element name="Timestamp" type="dateTime" minOccurs="0" maxOccurs="1"></element>
			<element name="Status" type="Authentication:AuthenticationStatus" minOccurs="1" maxOccurs="1"></element>
			<element name="Message" type="string" minOccurs="0" maxOccurs="1"></element>
			<element name="Subject" type="Authentication:SubjectDescriptor" minOccurs="0" maxOccurs="1"></element>
		</sequence>
	</complexType>

    <complexType name="UserNamePasswordAuthenticateRequest">
    	<complexContent>
		   	<extension base="Authentication:AuthenticateRequest">
				<sequence>
					<element name="UserName" type="string"  minOccurs="1" maxOccurs="1"></element>
					<element name="UserPassword" type="string"  minOccurs="1" maxOccurs="1"></element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
    
    <complexType name="AuthenticationExceptionReply">
    	<complexContent>
		   	<extension base="Authentication:AuthenticateReply">
				<sequence>
					<element name="ExceptionKind" type="string"></element>
					<element name="Message" type="string"></element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>

    <complexType name="SubjectDescriptor" abstract="true">
        <sequence>
            <element name="SubjectId" type="long" minOccurs="1" maxOccurs="1"></element>            
            <element name="SessionId" type="string"></element>
			<element name="Roles" type="Authentication:RoleDescriptor" maxOccurs="unbounded" minOccurs="1"></element>
        </sequence>
    </complexType>
    
    <complexType name="UserDescriptor">
    	<complexContent>
		   	<extension base="Authentication:SubjectDescriptor">
				<sequence>
					<element name="UserName" type="string"  minOccurs="1" maxOccurs="1"></element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
    
    <complexType name="RoleDescriptor">
        <sequence>
            <element name="SubjectId" type="long" minOccurs="1" maxOccurs="1"></element>
            <element name="RoleId" type="long" minOccurs="1" maxOccurs="1"></element>
            <element name="ParentRoleIds" type="long" minOccurs="0" maxOccurs="unbounded"></element>
            <element name="RoleName" type="string" minOccurs="1" maxOccurs="1"></element>
            <element name="Permissions" type="Authentication:PermissionDescriptor" minOccurs="1" maxOccurs="unbounded"></element>
        </sequence>
    </complexType>

    <complexType name="PermissionDescriptor">
        <sequence>
            <element name="SubjectId" type="long" minOccurs="1" maxOccurs="1"></element>
            <element name="RoleId" type="long" minOccurs="1" maxOccurs="1"></element>
            <element name="PermissionId" type="string" minOccurs="1" maxOccurs="1"></element>
            <element name="ImpliedPermissions" type="Authentication:PermissionDescriptor" minOccurs="0" maxOccurs="unbounded"></element>
            <element name="PermissionName" type="string"></element>
        </sequence>
    </complexType>

	<simpleType name="AuthenticationStatus">
		<restriction base="string">
			<enumeration value="SUCCEEDED"></enumeration>
			<enumeration value="FAILED"></enumeration>
		</restriction>
	</simpleType>
</schema>