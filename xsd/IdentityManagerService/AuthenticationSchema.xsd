<?xml version="1.0" encoding="UTF-8"?>
<schema
	id="GeneratedAuthenticationTypes" 
	xmlns="http://www.w3.org/2001/XMLSchema" 
	targetNamespace="http://IdentityManager.Service.Authentication"
	xmlns:Shared="http://IdentityManager.Service.Shared"
	xmlns:Authentication="http://IdentityManager.Service.Authentication" 
	elementFormDefault="qualified">

	<import 
		schemaLocation="SharedSchema.xsd" 
        namespace="http://IdentityManager.Service.Shared"/>
        	
    <complexType name="AuthenticateRequest" abstract="true">
    	<complexContent>
		   	<extension base="Shared:IdentityManagerRequest"/>
		</complexContent>
	</complexType>
    
    <complexType name="AuthenticateReply">
    	<complexContent>
		   	<extension base="Shared:IdentityManagerReply">
				<sequence>
					<element name="Authenticated" type="boolean" minOccurs="1" maxOccurs="1"/>
					<element name="Subject" type="Authentication:SubjectDescriptor" minOccurs="0" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>

    <complexType name="UserNamePasswordAuthenticateRequest">
    	<complexContent>
		   	<extension base="Authentication:AuthenticateRequest">
				<sequence>
					<element name="UserName" type="string"  minOccurs="1" maxOccurs="1"/>
					<element name="UserPassword" type="string"  minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
    
    <complexType name="AuthenticationExceptionReply">
    	<complexContent>
		   	<extension base="Authentication:AuthenticateReply">
				<sequence>
					<element name="ExceptionKind" type="string"></element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>

    <complexType name="SubjectDescriptor" abstract="true">
        <sequence>
            <element name="SubjectId" type="long" minOccurs="1" maxOccurs="1"/>            
            <element name="SessionId" type="string"/>
			<element name="Roles" type="Authentication:RoleDescriptor" maxOccurs="unbounded" minOccurs="1"/>
        </sequence>
    </complexType>
    
    <complexType name="UserDescriptor">
    	<complexContent>
		   	<extension base="Authentication:SubjectDescriptor">
				<sequence>
					<element name="UserName" type="string"  minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
    
    <complexType name="RoleDescriptor">
        <sequence>
            <element name="SubjectId" type="long" minOccurs="1" maxOccurs="1"/>
            <element name="RoleId" type="long" minOccurs="1" maxOccurs="1"/>
            <element name="ParentRoleIds" type="long" minOccurs="0" maxOccurs="unbounded"/>
            <element name="RoleName" type="string" minOccurs="1" maxOccurs="1"/>
            <element name="Permissions" type="Authentication:PermissionDescriptor" minOccurs="1" maxOccurs="unbounded"/>
        </sequence>
    </complexType>

    <complexType name="PermissionDescriptor">
        <sequence>
            <element name="SubjectId" type="long" minOccurs="1" maxOccurs="1"/>
            <element name="RoleId" type="long" minOccurs="1" maxOccurs="1"/>
            <element name="PermissionId" type="string" minOccurs="1" maxOccurs="1"/>
            <element name="ImpliedPermissions" type="Authentication:PermissionDescriptor" minOccurs="0" maxOccurs="unbounded"/>
            <element name="PermissionName" type="string"/>
        </sequence>
    </complexType>

</schema>