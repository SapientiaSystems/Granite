<?xml version="1.0" encoding="UTF-8"?>
<schema
	id="GeneratedSharedTypes" 
	xmlns="http://www.w3.org/2001/XMLSchema" 
	targetNamespace="http://IdentityManager.Service.Shared"
	xmlns:Shared="http://IdentityManager.Service.Shared" 
	elementFormDefault="qualified">

	<element name="Request" type="Shared:IdentityManagerRequest"/>
	<element name="Reply" type="Shared:IdentityManagerReply"/>
	<element name="Event" type="Shared:IdentityManagerEvent"/>	
	
    <complexType name="IdentityManagerRequest" abstract="true">
		<sequence>
			<element name="RequestId" type="string" minOccurs="1" maxOccurs="1"/>
			<element name="ReturnAddress" type="string" minOccurs="0" maxOccurs="1"/>
			<element name="Duplicate" type="boolean" minOccurs="0" maxOccurs="1"/>
			<element name="Timestamp" type="dateTime" minOccurs="0" maxOccurs="1"/>
		</sequence>
	</complexType>
    
    <complexType name="IdentityManagerReply">
		<sequence>
			<element name="ReplyId" type="string" minOccurs="1" maxOccurs="1"/>
			<element name="OriginatingRequestId" type="string" minOccurs="1" maxOccurs="1"/>
			<element name="Duplicate" type="boolean" minOccurs="0" maxOccurs="1"/>
			<element name="Timestamp" type="dateTime" minOccurs="0" maxOccurs="1"/>
			<element name="Status" type="Shared:OperationStatus" minOccurs="1" maxOccurs="1"/>
			<element name="Message" type="string" minOccurs="0" maxOccurs="1"/>
		</sequence>
	</complexType>
	
    <complexType name="IdentityManagerEvent" abstract="true">
		<sequence>
			<element name="EventId" type="string" minOccurs="1" maxOccurs="1"/>
			<element name="OriginatingRequestId" type="string" minOccurs="0" maxOccurs="1"/>
			<element name="Duplicate" type="boolean" minOccurs="0" maxOccurs="1"/>
			<element name="Timestamp" type="dateTime" minOccurs="0" maxOccurs="1"/>
		</sequence>
	</complexType>
    
	<simpleType name="OperationStatus">
		<restriction base="string">
			<enumeration value="SUCCEEDED"/>
			<enumeration value="FAILED"/>
		</restriction>
	</simpleType>
	
    <complexType name="UserIdentityDescriptor">
        <sequence>
            <element name="UserId" type="string" minOccurs="1" maxOccurs="1"/>
            <element name="UserName" type="string" minOccurs="1" maxOccurs="1"/>
            <element name="Roles" type="Shared:RoleDescriptor" minOccurs="0" maxOccurs="unbounded"/>
        </sequence>
    </complexType>

    <complexType name="RoleDescriptor">
        <sequence>
            <element name="UserId" type="string" minOccurs="1" maxOccurs="1"/>
            <element name="RoleId" type="string" minOccurs="1" maxOccurs="1"/>
            <element name="ParentRoleIds" type="string" minOccurs="0" maxOccurs="unbounded"/>
            <element name="RoleName" type="string" minOccurs="1" maxOccurs="1"/>
            <element name="Permissions" type="Shared:PermissionDescriptor" minOccurs="1" maxOccurs="unbounded"/>
        </sequence>
    </complexType>

    <complexType name="PermissionDescriptor">
        <sequence>
            <element name="UserId" type="string" minOccurs="1" maxOccurs="1"/>
            <element name="RoleId" type="string" minOccurs="1" maxOccurs="1"/>
            <element name="PermissionId" type="string" minOccurs="1" maxOccurs="1"/>
            <element name="ImpliedPermissions" type="Shared:PermissionDescriptor" minOccurs="0" maxOccurs="unbounded"/>
            <element name="PermissionName" type="string"/>
        </sequence>
    </complexType>
	
</schema>