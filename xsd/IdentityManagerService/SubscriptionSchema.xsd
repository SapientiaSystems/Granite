<?xml version="1.0" encoding="UTF-8"?>
<schema
	id="GeneratedSubscriptionTypes" 
	xmlns="http://www.w3.org/2001/XMLSchema" 
	targetNamespace="http://IdentityManager.Service.Subscription"
	xmlns:TransferObject="http://IdentityManager.Service.TransferObject"
	xmlns:Subscription="http://IdentityManager.Service.Subscription" 
	elementFormDefault="qualified">

	<import 
		schemaLocation="TransferObjectSchema.xsd" 
        namespace="http://IdentityManager.Service.TransferObject"/>

    <complexType name="SubscriptionRequest" abstract="true">
    	<complexContent>
		   	<extension base="TransferObject:IdentityManagerRequest">
				<sequence>
					<element name="SessionId" type="string"  minOccurs="1" maxOccurs="1"/>
					<element name="SubjectId" type="string"  minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
    
    <complexType name="SubscriptionReply" abstract="true">
    	<complexContent>
		   	<extension base="TransferObject:IdentityManagerReply">
				<sequence>
					<element name="SessionId" type="string"  minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	
    <complexType name="SubscriptionEvent" abstract="true">
    	<complexContent>
		   	<extension base="TransferObject:IdentityManagerEvent">
				<sequence>
					<element name="SessionId" type="string"  minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>

    <complexType name="CreateSubscriptionRequest">
    	<complexContent>
		   	<extension base="Subscription:SubscriptionRequest">
				<sequence>
					<element name="Subscription" type="Subscription:SubscriptionDescriptor"  minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
    
    <complexType name="CreateSubscriptionReply">
    	<complexContent>
		   	<extension base="Subscription:SubscriptionReply">
				<sequence>
					<element name="ExceptionKind" type="string"/>
					<element name="Message" type="string"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>

    <complexType name="UpdateSubscriptionRequest">
    	<complexContent>
		   	<extension base="Subscription:SubscriptionRequest">
				<sequence>
					<element name="Subscription" type="Subscription:SubscriptionDescriptor"  minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
    
    <complexType name="UpdateSubscriptionReply">
    	<complexContent>
		   	<extension base="Subscription:SubscriptionReply">
				<sequence>
					<element name="ExceptionKind" type="string"/>
					<element name="Message" type="string"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>

    <complexType name="StartListeningRequest">
    	<complexContent>
		   	<extension base="Subscription:SubscriptionRequest"/>
		</complexContent>
	</complexType>
    
    <complexType name="StartListeningReply">
    	<complexContent>
		   	<extension base="Subscription:SubscriptionReply"/>
		</complexContent>
	</complexType>

    <complexType name="StopListeningRequest">
    	<complexContent>
		   	<extension base="Subscription:SubscriptionRequest"/>
		</complexContent>
	</complexType>
    
    <complexType name="StopListeningReply">
    	<complexContent>
		   	<extension base="Subscription:SubscriptionReply"/>
		</complexContent>
	</complexType>
	
    <complexType name="NotifyTrialDaysRemainingEvent">
    	<complexContent>
		   	<extension base="Subscription:SubscriptionEvent">
				<sequence>
					<element name="DaysRemaining" type="integer"  minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>

    <complexType name="SubscriptionDescriptor">
        <sequence>
			<element name="UserName" type="string"  minOccurs="1" maxOccurs="1"/>
			<element name="UserPassword" type="string"  minOccurs="1" maxOccurs="1"/>
			<element name="EmailAddress" type="string"  minOccurs="1" maxOccurs="1"/>
			<element name="SubscriptionLevel" type="string"  minOccurs="1" maxOccurs="1"/>
			<element name="PaymentMethod" type="Subscription:PaymentMethodDescriptor" maxOccurs="1" minOccurs="1"/>
        </sequence>
    </complexType>
    
    <complexType name="PaymentMethodDescriptor" abstract="true"/>
    
    <complexType name="NullPaymentMethodDescriptor">
    	<complexContent>
		   	<extension base="Subscription:PaymentMethodDescriptor">
			</extension>
		</complexContent>
	</complexType>
    
    <complexType name="CreditCardPaymentMethodDescriptor">
    	<complexContent>
		   	<extension base="Subscription:PaymentMethodDescriptor">
				<sequence>
					<element name="Kind" type="Subscription:CreditCardKind"  minOccurs="1" maxOccurs="1"/>
					<element name="CardNumber" type="string"  minOccurs="1" maxOccurs="1"/>
					<element name="HolderName" type="string"  minOccurs="1" maxOccurs="1"/>
					<element name="BillingAddress" type="Subscription:Address"  minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>

    <complexType name="PayPalPaymentMethodDescriptor">
    	<complexContent>
		   	<extension base="Subscription:PaymentMethodDescriptor">
				<sequence>
					<element name="AccountNumber" type="string"  minOccurs="1" maxOccurs="1"/>
					<element name="HolderName" type="string"  minOccurs="1" maxOccurs="1"/>
					<element name="BillingAddress" type="Subscription:Address"  minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
    
    <complexType name="Address">
        <sequence>
            <element name="StreetLocation" type="string" minOccurs="1" maxOccurs="1"/>
            <element name="City" type="string" minOccurs="1" maxOccurs="1"/>
            <element name="State" type="string" minOccurs="1" maxOccurs="1"/>
            <element name="PostalCode" type="string" minOccurs="1" maxOccurs="1"/>
            <element name="Country" type="string" minOccurs="0" maxOccurs="1"/>
        </sequence>
    </complexType>

	<simpleType name="CreditCardKind">
		<restriction base="string">
			<enumeration value="VISA"/>
			<enumeration value="MASTER_CARD"/>
			<enumeration value="AMERICAN_EXPRESS"/>
			<enumeration value="DISCOVER"/>
			<enumeration value="OTHER"/>
		</restriction>
	</simpleType>
</schema>