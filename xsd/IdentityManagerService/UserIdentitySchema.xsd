<?xml version="1.0" encoding="UTF-8"?>
<schema
	id="GeneratedUserIdentityTypes" 
	xmlns="http://www.w3.org/2001/XMLSchema" 
	targetNamespace="http://IdentityManager.Service.UserIdentity"
	xmlns:Shared="http://IdentityManager.Service.Shared"
	xmlns:UserIdentity="http://IdentityManager.Service.UserIdentity" 
	elementFormDefault="qualified">

	<import 
		schemaLocation="SharedSchema.xsd" 
        namespace="http://IdentityManager.Service.Shared"/>

    <complexType 
    	name="UserIdentityRequest" 
    	abstract="true">
    	<complexContent>
		   	<extension base="Shared:IdentityManagerRequest">
				<sequence>
					<element name="SessionId" type="string"  minOccurs="1" maxOccurs="1"/>
					<element name="UserId" type="string"  minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
    
    <complexType 
    	name="UserIdentityReply" 
    	abstract="true">
    	<complexContent>
		   	<extension base="Shared:IdentityManagerReply">
				<sequence>
					<element name="SessionId" type="string"  minOccurs="1" maxOccurs="1"/>
					<element name="ExceptionKind" type="UserIdentity:UserIdentityExceptionKind" minOccurs="0" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	
    <complexType 
    	name="UserIdentityEvent" 
    	abstract="true">
    	<complexContent>
		   	<extension base="Shared:IdentityManagerEvent">
				<sequence>
					<element name="SessionId" type="string"  minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>

    <complexType 
    	name="StartCreatingUserIdentityRequest">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityRequest">
				<sequence>
					<element name="User" type="UserIdentity:UserIdentityData"  minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
    
    <complexType 
    	name="StartCreatingUserIdentityReply">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityReply">
				<sequence>
					<element name="PendingEventId" type="long" minOccurs="0" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>

    <complexType 
    	name="FinishCreatingUserIdentityRequest">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityRequest">
				<sequence>
					<element name="PendingEventId" type="long" minOccurs="1" maxOccurs="1"/>
					<element name="VerificationCode" type="string" minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
    
    <complexType 
    	name="FinishCreatingUserIdentityReply">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityReply">
				<sequence>
					<element name="User" type="Shared:UserIdentityDescriptor" minOccurs="0" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>


    <complexType 
    	name="StartUpdatingUserIdentityRequest">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityRequest">
				<sequence>
					<element name="User" type="UserIdentity:UserIdentityData"  minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
    
    <complexType 
    	name="StartUpdatingUserIdentityReply">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityReply">
				<sequence>
					<element name="PendingEventId" type="long" minOccurs="0" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>

    <complexType 
    	name="FinishUpdatingUserIdentityRequest">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityRequest">
				<sequence>
					<element name="PendingEventId" type="long" minOccurs="1" maxOccurs="1"/>
					<element name="VerificationCode" type="string" minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
    
    <complexType 
    	name="FinishUpdatingUserIdentityReply">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityReply">
				<sequence>
					<element name="User" type="Shared:UserIdentityDescriptor" minOccurs="0" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>

    <complexType name="UpdateUserIdentityRequest">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityRequest">
				<sequence>
					<element name="User" type="UserIdentity:UserIdentityData"  minOccurs="1" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
    
    <complexType name="UpdateUserIdentityReply">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityReply">
				<sequence>
					<element name="User" type="Shared:UserIdentityDescriptor" minOccurs="0" maxOccurs="1"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>

    <complexType name="StartListeningRequest">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityRequest"/>
		</complexContent>
	</complexType>
    
    <complexType name="StartListeningReply">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityReply"/>
		</complexContent>
	</complexType>

    <complexType name="StopListeningRequest">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityRequest"/>
		</complexContent>
	</complexType>
    
    <complexType name="StopListeningReply">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityReply"/>
		</complexContent>
	</complexType>
    
    <complexType name="CreatedUserIdentityEvent">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityEvent">
				<sequence>
					<element name="OriginatingRequestId" type="string" minOccurs="1" maxOccurs="1"/>
					<element name="User" type="Shared:UserIdentityDescriptor" minOccurs="0" maxOccurs="1"/>
				</sequence>
		   	</extension>
		</complexContent>
	</complexType>
	
    <complexType name="UpdatedUserIdentityEvent">
    	<complexContent>
		   	<extension base="UserIdentity:UserIdentityEvent">
				<sequence>
					<element name="OriginatingRequestId" type="string" minOccurs="1" maxOccurs="1"/>
					<element name="User" type="Shared:UserIdentityDescriptor" minOccurs="0" maxOccurs="1"/>
				</sequence>
		   	</extension>
		</complexContent>
	</complexType>
	
    <complexType name="UserIdentityData">
        <sequence>
			<element name="UserId" type="long"  minOccurs="0" maxOccurs="1"/>
			<element name="UserName" type="string"  minOccurs="0" maxOccurs="1"/>
			<element name="UserPassword" type="string"  minOccurs="0" maxOccurs="1"/>
			<element name="EmailAddress" type="string"  minOccurs="0" maxOccurs="1"/>
			<element name="PersonName" type="UserIdentity:PersonNameData"  minOccurs="0" maxOccurs="1"/>
			<element name="SecurityQuestions" type="UserIdentity:SecurityQuestionData" minOccurs="0" maxOccurs="unbounded"/>
        </sequence>
    </complexType>
      
    <complexType name="PersonNameData">
        <sequence>
            <element name="FirstName" type="string" minOccurs="1" maxOccurs="1"/>
            <element name="MiddleName" type="string" minOccurs="0" maxOccurs="1"/>
            <element name="LastName" type="string" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>

    <complexType name="SecurityQuestionData">
        <sequence>
            <element name="QuestionId" type="long" minOccurs="1" maxOccurs="1"/>
            <element name="Question" type="string" minOccurs="0" maxOccurs="1"/>
            <element name="Answer" type="string" minOccurs="0" maxOccurs="1"/>
        </sequence>
    </complexType>
     
	<simpleType name="UserIdentityExceptionKind">
		<restriction base="string">
			<enumeration value="CREATE_FAILED"/>
			<enumeration value="UPDATE_FAILED"/>
		</restriction>
	</simpleType>
    
</schema>