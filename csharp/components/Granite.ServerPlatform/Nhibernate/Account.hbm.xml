<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping
    xmlns="urn:nhibernate-mapping-2.2"
    assembly="Granite.Domain"
    namespace="Granite.Domain.Payment">

    <class
        name="IAccount"
        table="dbo.Account"
        batch-size="50">
        <cache usage="read-write" region="Account"/>

        <id name="PrimaryId" column="AccountId" generator="guid.comb"/>
        <discriminator column="AccountType" type="String"/>
        <version name="Version" column="Version"/>
        <property name="Created" column="Created" not-null="false"/>
        <property name="LastModified" column="LastModified" not-null="false"/>

        <property name="TenantId" column="TenantId" index="TenantId" not-null="true"/>
        <property name="UserId" column="UserId" index="UserId" not-null="true"/>
        
        <property name="ExternalAccountId" column="ExternalAccountId" index="ExternalAccountId" not-null="true"/>
        <property name="ExternalPaymentMethodId" column="ExternalPaymentMethodId" index="ExternalPaymentMethodId" not-null="false"/>

        <property name="IsActive" column="IsActive" not-null="true"/>

        <subclass
            name="StandardAccount"
            discriminator-value="StandardAccount"/>
            
    </class>

    <query
        name="Account.GetAllFor">
        <![CDATA[
            select distinct a
            from IAccount a
            where a.UserId = :userId]]>
    </query>
    <query
        name="Account.HasAnyFor"
        cacheable="true">
        <![CDATA[
            select count(a.UserId)
            from IAccount a
            where a.UserId = :userId]]>
    </query>

</hibernate-mapping>