<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping
    xmlns="urn:nhibernate-mapping-2.2"
    assembly="Granite.Domain"
    namespace="Granite.Domain.Payment">

    <class
        name="IPlan"
        table="dbo.PlanData"
        batch-size="50">
        <cache usage="read-write" region="Plan"/>

        <id name="PrimaryId" column="PlanId" generator="guid.comb"/>
        <discriminator column="SubscriptionPlanType" type="String"/>
        <version name="Version" column="Version"/>
        <property name="Created" column="Created" not-null="false"/>
        <property name="LastModified" column="LastModified" not-null="false"/>

        <property name="PlanName" column="PlanName" unique-key="PlanName" not-null="true"/>
        <property name="ExternalPlanId" column="ExternalPlanId" index="ExternalPlanId" not-null="true"/>
        <property
            name="IntervalType"
            column="IntervalType"
            type="NHibernate.Type.EnumStringType`1[[Granite.Common.Value.PaymentIntervalKind, Granite.Common]], NHibernate"
            not-null="true"/>
        <property name="IntervalCount" column="IntervalCount" not-null="true"/>
        <property name="Currency" column="Currency" not-null="true"/>
        <property name="Amount" column="Amount" not-null="true"/>

        <subclass
            name="StandardPlan"
            discriminator-value="StandardPlan"/>
            
    </class>

    <query
        name="Plan.GetUniqueWithPlanName">
        <![CDATA[
            select distinct p
            from IPlan p
            where p.PlanName = :planName]]>
    </query>
    <query
        name="Plan.HasUniqueWithPlanName"
        cacheable="true">
        <![CDATA[
            select count(p.PlanName)
            from IPlan p
            where p.PlanName = :planName]]>
    </query>

</hibernate-mapping>