<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping
    xmlns="urn:nhibernate-mapping-2.2"
    assembly="Granite.Domain"
    namespace="Granite.Domain.User">

    <class
        name="IUser"
        table="dbo.UserData"
        batch-size="50">
        <cache usage="read-write" region="IUser"/>

        <id name="PrimaryId" column="UserId" generator="guid.comb"/>
        <discriminator column="UserType" type="String"/>
        <version name="Version" column="Version"/>
        <property name="Created" column="Created" not-null="true"/>
        <property name="LastModified" column="LastModified" not-null="true"/>

        <property name="TenantId" column="TenantId" index="TenantId" not-null="true"/>

        <property name="UserName" column="UserName" unique-key="UserName" not-null="true"/>
        <property
            name="Password"
            type="Strata.Nhibernate.Mapping.HashedStringType, Strata.Nhibernate"
            not-null="true">
            <column name="PasswordHash"/>
            <column name="PasswordSalt"/>
        </property>
        <property
            name="Email"
            type="Strata.Nhibernate.Mapping.EmailAddressType, Strata.Nhibernate"
            not-null="false">
            <column name="Email"/>
        </property>
        <property name="ExternalUserId" column="ExternalUserId" index="ExternalUserId" not-null="false"/>
        <property
            name="Status"
            column="Status"
            type="NHibernate.Type.EnumStringType`1[[Granite.Domain.User.UserStatus, Granite.Domain]], NHibernate"
            not-null="true"/>
        <property name="VerificationCode" column="VerificationCode"  not-null="false"/>

        <subclass
            name="StandardUser"
            discriminator-value="StandardUser">
            <property
                name="RoleIds"
                type="Granite.ServerPlatform.Nhibernate.StringSetType, Granite.ServerPlatform"
                not-null="false">
                <column name="RoleIds" sql-type="varchar(4096)"/>
            </property>
            <property
                name="ConstraintIds"
                type="Granite.ServerPlatform.Nhibernate.ConstraintIdDictionaryType, Granite.ServerPlatform"
                not-null="false">
                <column name="ConstraintIds" sql-type="varchar(4096)"/>
            </property>

        </subclass>
            
    </class>

    <!--
    <class
        name="IGroup"
        table="dbo.GroupData"
        batch-size="50">
        <cache usage="read-write" region="IGroup"/>

        <id name="PrimaryId" column="GroupName"/>
        <discriminator column="GroupType" type="String"/>
        <version name="Version" column="Version"/>
        <property name="Created" column="Created" not-null="true"/>
        <property name="LastModified" column="LastModified" not-null="true"/>
        <property
            name="IncludedGroupNames"
            type="Granite.ServerPlatform.Nhibernate.StringSetType, Granite.ServerPlatform"
            not-null="false">
            <column name="IncludedGroupNames"/>
        </property>

        <subclass
            name="StandardGroup"
            discriminator-value="StandardGroup"/>

    </class>
    -->
    
    <query
        name="User.GetUniqueWithExternalUserId">
        <![CDATA[
            select distinct u
            from IUser u
            where u.ExternalUserId = :externalUserId]]>
    </query>
    <query
        name="User.GetUniqueWithUserName">
        <![CDATA[
            select distinct u
            from IUser u
            where u.UserName = :userName]]>
    </query>
    <query
        name="User.HasUniqueWithExternalUserId"
        cacheable="true">
        <![CDATA[
            select count(u.ExternalUserId)
            from IUser u
            where u.ExternalUserId = :externalUserId]]>
    </query>
    <query
        name="User.HasUniqueWithUserName"
        cacheable="true">
        <![CDATA[
            select count(u.UserName)
            from IUser u
            where u.UserName = :userName]]>
    </query>

</hibernate-mapping>