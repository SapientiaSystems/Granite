<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping 
    xmlns="urn:nhibernate-mapping-2.2"
    assembly="Granite.Domain"
    namespace="Granite.Domain.User">

    <class
      name="UserIdentity"
      table="dbo.UserIdentity"
      batch-size="50">
      <cache usage="read-write" region="UserIdentity"/>

      <id name="UserId" column="UserId" generator="guid.comb"/>
      <version name="Version" column="Version"/>

      <property name="ExternalUserId" column="ExternalUserId" not-null="true"/>
      <property
          name="Status"
          column="Status"
          type="NHibernate.Type.EnumStringType`1[[Granite.Domain.User.UserStatus, Granite.Domain]], NHibernate"
          not-null="true"/>
      <property name="VerificationCode" column="VerificationCode"  not-null="false"/>
      <property name="Created" column="Created" not-null="true"/>
      <property name="LastModified" column="LastModified" not-null="true"/>
    </class>
  
    <query
        name="UserIdentity.GetUserIdentityWithExternalUserId">
        <![CDATA[
            select distinct u
            from UserIdentity u
            where u.ExternalUserId = :id]]>
    </query>
    <query
        name="UserIdentity.HasUserIdentityWithExternalUserId"
        cacheable="true">
        <![CDATA[
            select count(u.ExternalUserId)
            from UserIdentity u
            where u.ExternalUserId = :id]]>
    </query>

</hibernate-mapping>