<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping
    xmlns="urn:nhibernate-mapping-2.2"
    assembly="Granite.Domain"
    namespace="Granite.Domain.Group">

    <class
        name="IGroup"
        table="dbo.GroupData"
        batch-size="50">
        <cache usage="read-write" region="Group"/>
        
        <composite-id 
            name="MultiTenantPrimaryId" 
            class="Granite.Domain.Shared.MultiTenantId`1[System.String], Granite.Domain">
            <key-property name="TenantId" column="TenantId"/>
            <key-property name="EntityId" column="GroupId"/>
        </composite-id>
        <discriminator column="GroupType" type="String"/>
        <version name="Version" column="Version"/>
        <property name="Created" column="Created" not-null="true"/>
        <property name="LastModified" column="LastModified" not-null="true"/>

        <set name="MemberUserIds" table="MemberUserIds" lazy="false">
            <key>
                <column name="TenantId"/>
                <column name="GroupId"/>
            </key>
            <element column="UserId" type="Guid"/>
        </set>

        <set name="IncludedGroups" table="IncludedGroups" lazy="false">
            <key>
                <column name="SuperTenantId"/>
                <column name="SuperGroupId"/>
            </key>
            <many-to-many class="IGroup">
                <column name="SubTenantId"/>
                <column name="SubGroupId"/>
            </many-to-many>
        </set>

        <subclass
            name="StandardGroup"
            discriminator-value="StandardGroup">
            <property
                name="RoleIds"
                type="Granite.ServerPlatform.Nhibernate.StringSetType, Granite.ServerPlatform"
                not-null="false">
                <column name="RoleIds" sql-type="varchar(4096)"/>
            </property>

        </subclass>
            
    </class>
    
    <query
        name="Group.GetGroupsFor">
        <![CDATA[
            select distinct g
            from IGroup g
            where :userId in elements(g.MemberUserIds)]]>
    </query>
    
