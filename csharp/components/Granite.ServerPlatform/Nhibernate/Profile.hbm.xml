<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping
    xmlns="urn:nhibernate-mapping-2.2"
    assembly="Granite.Domain"
    namespace="Granite.Domain.Profile">

    <class
        name="IProfile"
        table="dbo.Profile"
        batch-size="50">
        <cache usage="read-write" region="Profile"/>

        <id name="PrimaryId" column="ProfileId" generator="guid.comb"/>
        <discriminator column="ProfileType" type="String"/>
        <version name="Version" column="Version"/>
        <property name="Created" column="Created" not-null="false"/>
        <property name="LastModified" column="LastModified" not-null="false"/>

        <property name="UserId" column="UserId" index="UserId" not-null="true"/>
        <property name="UserName" column="UserName" index="UserName" not-null="true"/>

        <property
            name="Name"
            type="Strata.Nhibernate.Mapping.PersonNameType, Strata.Nhibernate"
            not-null="false">
            <column name="FirstName"/>
            <column name="MiddleName"/>
            <column name="LastName"/>
        </property>
        <property
            name="Email"
            type="Strata.Nhibernate.Mapping.EmailAddressType, Strata.Nhibernate"
            not-null="false">
            <column name="Email"/>
        </property>
        <property
            name="Phone"
            type="Strata.Nhibernate.Mapping.PhoneNumberType, Strata.Nhibernate"
            not-null="false">
            <column name="Phone"/>
        </property>
        <property
            name="Address"
            type="Strata.Nhibernate.Mapping.PostalAddressType, Strata.Nhibernate"
            not-null="false">
            <column name="StreetAddress"/>
            <column name="City"/>
            <column name="State"/>
            <column name="PostalCode"/>
            <column name="Country"/>
        </property>
        
        <property name="JobTitle" column="JobTitle" not-null="true"/>

        <subclass
            name="StandardProfile"
            discriminator-value="StandardProfile"/>
            
    </class>

    <query
        name="Profile.GetUniqueFor">
        <![CDATA[
            select distinct p
            from IProfile p
            where p.UserId = :userId]]>
    </query>
    <query
        name="Profile.GetUniqueWithUserName">
        <![CDATA[
            select distinct p
            from IProfile p
            where p.UserName = :userName]]>
    </query>
    <query
        name="Profile.HasUniqueFor"
        cacheable="true">
        <![CDATA[
            select count(p.UserId)
            from IProfile p
            where p.UserId = :userId]]>
    </query>
    <query
        name="Profile.HasUniqueWithUserName"
        cacheable="true">
        <![CDATA[
            select count(p.UserName)
            from IProfile p
            where p.UserName = :userName]]>
    </query>

</hibernate-mapping>