<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping
    xmlns="urn:nhibernate-mapping-2.2"
    assembly="Granite.Domain"
    namespace="Granite.Domain.Payment">

    <class
        name="ISubscription"
        table="dbo.Subscription"
        batch-size="50">
        <cache usage="read-write" region="Subscription"/>

        <id name="PrimaryId" column="SubscriptionId" generator="guid.comb"/>
        <discriminator column="SubscriptionType" type="String"/>
        <version name="Version" column="Version"/>
        <property name="Created" column="Created" not-null="false"/>
        <property name="LastModified" column="LastModified" not-null="false"/>

        <property name="AccountId" column="AccountId" index="AccountId" not-null="true"/>
        <property name="PlanId" column="PlanId" index="PlanId" not-null="true"/>
        <property name="UserId" column="UserId" index="UserId" not-null="true"/>
        
        <property name="ExternalSubscriptionId" column="ExternalSubscriptionId" index="ExternalSubscriptionId" not-null="true"/>
        <property name="ExternalPlanId" column="ExternalPlanId" index="ExternalPlanId" not-null="true"/>
        
        <property name="InitialPaymentDate" column="InitialPaymentDate" index="InitialPaymentDate" not-null="true"/>

        <subclass
            name="StandardSubscription"
            discriminator-value="StandardSubscription"/>
            
    </class>

    <query
        name="Subscription.GetAllWithAccountId">
        <![CDATA[
            select distinct s
            from ISubscription s
            where s.AccountId = :accountId]]>
    </query>
    <query
        name="Subscription.GetUniqueWithAccountId">
        <![CDATA[
            select distinct s
            from ISubscription s
            where s.AccountId = :accountId]]>
    </query>
    <query
        name="Subscription.GetAllWithUserId">
        <![CDATA[
            select distinct s
            from ISubscription s
            where s.UserId = :userId]]>
    </query>
    <query
        name="Subscription.GetUniqueWithUserId">
        <![CDATA[
            select distinct s
            from ISubscription s
            where s.UserId = :userId]]>
    </query>
    <query
        name="Subscription.HasAnyWithAccoutId"
        cacheable="true">
        <![CDATA[
            select count(s.AccountId)
            from ISubscription s
            where s.AccountId = :accountId]]>
    </query>
    <query
        name="Subscription.HasAnyWithUserId"
        cacheable="true">
        <![CDATA[
            select count(s.UserId)
            from ISubscription s
            where s.UserId = :userId]]>
    </query>

</hibernate-mapping>