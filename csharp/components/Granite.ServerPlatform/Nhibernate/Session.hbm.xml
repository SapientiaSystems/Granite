<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping
    xmlns="urn:nhibernate-mapping-2.2"
    assembly="Granite.Domain"
    namespace="Granite.Domain.Session">

    <class
        name="ISession"
        table="dbo.Session"
        batch-size="50">
        <cache usage="read-write" region="IUser"/>

        <id name="PrimaryId" column="SessionId" generator="guid.comb"/>
        <discriminator column="SessionType" type="String"/>
        <version name="Version" column="Version"/>
        <property name="Created" column="Created" not-null="false"/>
        <property name="LastModified" column="LastModified" not-null="false"/>

        <property name="UserId" column="UserId" index="UserId" not-null="true"/>
        <property name="AccessToken" column="AccessToken" index="AccessToken" not-null="false"/>
        
        <property name="LastRefresh" column="LastRefresh" not-null="false"/>
        <property name="LastRequest" column="LastRequest" not-null="false"/>

        <subclass
            name="StandardSession"
            discriminator-value="StandardSession">
            <property name="IsOpen" column="IsOpen" not-null="true"/>
        </subclass>
            
    </class>

    <query
        name="Session.GetUniqueWithAccessToken">
        <![CDATA[
            select distinct s
            from ISession s
            where s.AccessToken = :accessToken]]>
    </query>
    <query
        name="Session.GetAllWithUserId">
        <![CDATA[
            select distinct s
            from ISession s
            where s.UserId = :userId]]>
    </query>
    <query
        name="Session.HasUniqueWithAccessToken"
        cacheable="true">
        <![CDATA[
            select count(s.AccessToken)
            from ISession s
            where s.AccessToken = :accessToken]]>
    </query>
    <query
        name="Session.HasAnyWithUserId"
        cacheable="true">
        <![CDATA[
            select count(s.UserId)
            from ISession s
            where s.UserId = :userId]]>
    </query>

</hibernate-mapping>