<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping
    xmlns="urn:nhibernate-mapping-2.2"
    assembly="Granite.Domain"
    namespace="Granite.Domain.Session">

    <class
        name="ISession"
        table="dbo.Session"
        batch-size="50">
        <cache usage="read-write" region="IUser"/>

        <id name="SessionId" column="SessionId" generator="guid.comb"/>
        <discriminator column="SessionType" type="String"/>
        <version name="Version" column="Version"/>

        <property name="UserId" column="UserId" index="UserId" not-null="true"/>
        <property name="AccessToken" column="AccessToken" not-null="false"/>
        <property name="AccessTokenType" column="AccessTokenType" not-null="false"/>
        <property name="RefreshToken" column="RefreshToken" not-null="false"/>
        <property name="Created" column="Created" not-null="false"/>
        <property name="LastRefresh" column="LastRefresh" not-null="false"/>
        <property name="LastRequest" column="LastRequest" not-null="false"/>

        <subclass
            name="StandardSession"
            discriminator-value="StandardSession"/>
            
    </class>

    <query
        name="Session.GetAllWithUserId">
        <![CDATA[
            select distinct s
            from ISession s
            where s.UserId = :userId]]>
    </query>
    <query
        name="Session.HasAnyWithUserId"
        cacheable="true">
        <![CDATA[
            select count(s.UserId)
            from ISession s
            where s.UserId = :userId]]>
    </query>

</hibernate-mapping>