[req]
default_bits = 2048
prompt = no
distinguished_name = dn
req_extensions = v3_req

[dn]
CN = granite-services
O = Granite

[v3_req]
subjectAltName = @alt_names
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth, clientAuth

[alt_names]
DNS.1 = localhost
DNS.2 = host.docker.internal
DNS.3 = granite-frontendcontroller-userhost
DNS.4 = granite-frontendcontroller-userhost.granite.svc.cluster.local
DNS.5 = granite-frontendcontroller-adminhost
DNS.6 = granite-frontendcontroller-adminhost.granite.svc.cluster.local
DNS.7 = granite-user-commandhost
DNS.8 = granite-user-commandhost.granite.svc.cluster.local
DNS.9 = granite-user-queryhost
DNS.10 = granite-user-queryhost.granite.svc.cluster.local
DNS.11 = granite-session-commandhost
DNS.12 = granite-session-commandhost.granite.svc.cluster.local
DNS.13 = granite-session-queryhost
DNS.14 = granite-session-queryhost.granite.svc.cluster.local
DNS.15 = granite-gateway-servicehost
DNS.16 = granite-gateway-servicehost.granite.svc.cluster.local
DNS.17 = granite-outbox-servicehost
DNS.18 = granite-outbox-servicehost.granite.svc.cluster.local
DNS.19 = granite-feedback-commandhost
DNS.20 = granite-feedback-commandhost.granite.svc.cluster.local
DNS.21 = granite-feedback-queryhost
DNS.22 = granite-feedback-queryhost.granite.svc.cluster.local
DNS.23 = granite-survey-commandhost
DNS.24 = granite-survey-commandhost.granite.svc.cluster.local
DNS.25 = granite-survey-queryhost
DNS.26 = granite-survey-queryhost.granite.svc.cluster.local
DNS.27 = granite-content-commandhost
DNS.28 = granite-content-commandhost.granite.svc.cluster.local
DNS.29 = granite-content-queryhost
DNS.30 = granite-content-queryhost.granite.svc.cluster.local
DNS.31 = granite-agent-commandhost
DNS.32 = granite-agent-commandhost.granite.svc.cluster.local
DNS.33 = granite-agent-queryhost
DNS.34 = granite-agent-queryhost.granite.svc.cluster.local
DNS.35 = granite-client-commandhost
DNS.36 = granite-client-commandhost.granite.svc.cluster.local
DNS.37 = granite-client-queryhost
DNS.38 = granite-client-queryhost.granite.svc.cluster.local
DNS.39 = granite-web-apphost
DNS.40 = granite-web-apphost.granite.svc.cluster.local
DNS.41 = granite-web-clienthost
DNS.42 = granite-web-clienthost.granite.svc.cluster.local
IP.1 = 127.0.0.1
