<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings>
    xmlns="http://java.sun.com/xml/ns/persistence/orm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    version="1.0"
    xsi:schemaLocation="http://java.sun.com/xml/ns/persistence/orm http://java.sun.com/xml/ns/persistence/orm_1_0.xsd">
    <description>Agent object relational entity mappings</description>

    <entity class="granite.agent.server.domain.Conversation" access="PROPERTY">
        <table name="AgentConversation"/>
        <inheritance strategy="SINGLE_TABLE"/>
        <attributes>
            <id name="primaryId">
                <column name="conversationId"/>
                <generated-value strategy="IDENTITY"/>
            </id>
            <basic name="created">
                <column name="created"/>
            </basic>
            <basic name="lastModified">
                <column name="lastModified"/>
            </basic>
            <basic name="userId" optional="false">
                <column name="userId" nullable="false"/>
            </basic>
            <basic name="title">
                <column name="title" column-definition="VARCHAR(128)"/>
            </basic>
            <basic name="transcript" access="FIELD">
                <column name="transcript" column-definition="TEXT"/>
                <convert converter="granite.agent.server.domain.TranscriptConverter"/>
            </basic>
            <basic name="history">
                <column name="history" column-definition="TEXT"/>
            </basic>
            <basic name="pendingCalls">
                <column name="pendingCalls" column-definition="TEXT"/>
            </basic>
            <basic name="collectedResults">
                <column name="collectedResults" column-definition="TEXT"/>
            </basic>
            <basic name="pendingSummary">
                <column name="pendingSummary" column-definition="TEXT"/>
            </basic>
            <basic name="inputTokens">
                <column name="inputTokens"/>
            </basic>
            <basic name="outputTokens">
                <column name="outputTokens"/>
            </basic>
            <basic name="started">
                <column name="started"/>
            </basic>
            <basic name="changed">
                <column name="changed"/>
            </basic>
            <version name="version">
                <column name="version"/>
            </version>
            <transient name="self"/>
            <transient name="observers"/>
            <transient name="conversationId"/>
        </attributes>
    </entity>
</entity-mappings>
