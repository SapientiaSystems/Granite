<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings>
    xmlns="http://java.sun.com/xml/ns/persistence/orm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    version="1.0"
    xsi:schemaLocation="http://java.sun.com/xml/ns/persistence/orm http://java.sun.com/xml/ns/persistence/orm_1_0.xsd">
    <description>Session object relational entity mappings</description>

    <entity class="granite.session.server.domain.Session" access="PROPERTY">
        <table name="Session"/>
        <inheritance strategy="SINGLE_TABLE"/>
        <attributes>
            <id name="primaryId">
                <column name="sessionId"/>
                <generated-value strategy="IDENTITY"/>
            </id>
            <basic name="created">
                <column name="created"/>
            </basic>
            <basic name="lastModified">
                <column name="lastModified"/>
            </basic>
            <basic name="userId" optional="false">
                <column name="userId" nullable="false"/>
            </basic>
            <basic name="accessToken" optional="false">
                <column name="accessToken" unique="true" nullable="false" column-definition="VARCHAR(2048)"/>
            </basic>
            <basic name="refreshTokenHash">
                <column name="refreshTokenHash" unique="true" column-definition="VARCHAR(64)"/>
            </basic>
            <basic name="previousRefreshTokenHash">
                <column name="previousRefreshTokenHash" column-definition="VARCHAR(64)"/>
            </basic>
            <basic name="expires" optional="false">
                <column name="expires" nullable="false"/>
            </basic>
            <basic name="deviceId" optional="false">
                <column name="deviceId" nullable="false" column-definition="VARCHAR(255)"/>
            </basic>
            <basic name="authorities">
                <column name="authorities" column-definition="VARCHAR(1024)"/>
                <convert converter="strata.server.spring.value.StringSetConverter"/>
            </basic>
            <basic name="values" access="FIELD">
                <column name="sessionValues" column-definition="TEXT"/>
                <convert converter="strata.server.spring.value.StringMapConverter"/>
            </basic>
            <basic name="hashedHandle">
                <column name="hashedHandle" unique="true" column-definition="VARCHAR(64)"/>
            </basic>
            <basic name="lastActivity">
                <column name="lastActivity"/>
            </basic>
            <basic name="closedReason">
                <column name="closedReason" column-definition="VARCHAR(32)"/>
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="activeMarker">
                <column name="activeMarker"/>
            </basic>
            <basic name="continuityId">
                <column name="continuityId"/>
            </basic>
            <basic name="replacedBy">
                <column name="replacedBy"/>
            </basic>
            <basic name="copiedFrom">
                <column name="copiedFrom"/>
            </basic>
            <version name="version">
                <column name="version"/>
            </version>
            <transient name="self"/>
            <transient name="observers"/>
            <transient name="sessionId"/>
            <transient name="closed"/>
        </attributes>
    </entity>

</entity-mappings>
