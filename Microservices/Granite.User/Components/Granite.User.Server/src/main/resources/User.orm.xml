<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings>
    xmlns="http://java.sun.com/xml/ns/persistence/orm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    version="1.0"
    xsi:schemaLocation="http://java.sun.com/xml/ns/persistence/orm http://java.sun.com/xml/ns/persistence/orm_1_0.xsd">
    <description>User object relational entity mappings</description>

    <entity class="granite.user.server.domain.User" access="PROPERTY">
        <table name="UserData"/>
        <inheritance strategy="SINGLE_TABLE"/>
        <attributes>
            <id name="primaryId">
                <column name="primaryId"/>
                <generated-value strategy="IDENTITY"/>
            </id>
            <basic name="created">
                <column name="created"/>
            </basic>
            <basic name="lastModified">
                <column name="lastModified"/>
            </basic>
            <basic name="foo">
                <column name="foo"/>
            </basic>
            <basic name="userName" optional="false">
                <column name="userName" unique="true" nullable="false" column-definition="VARCHAR(255)"/>
            </basic>
            <basic name="password" optional="true">
                <column name="password" nullable="true" column-definition="VARCHAR(255)"/>
            </basic>
            <basic name="externalIdentity" optional="true">
                <column name="externalIdentity" unique="true" nullable="true" column-definition="VARCHAR(512)"/>
            </basic>
            <version name="version">
                <column name="version"/>
            </version>
            <transient name="self"/>
        </attributes>
    </entity>

</entity-mappings>