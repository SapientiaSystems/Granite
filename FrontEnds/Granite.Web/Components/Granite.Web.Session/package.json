{
    "name": "granite.web.session",
    "version": "1.0.0",
    "description": "",
    "private": true,
    "scripts": {
        "copy-files": "shx cp src/main/typescript/package.json .build/dist/package.json",
        "clean": "del-cli -f .build/dist",
        "deep-clean": "yarn run clean && del-cli -f node_modules && del-cli -f yarn.lock",
        "dev-init": "yarn --dev install",
        "build-init": "yarn run dev-init && yarn install && yarn run clean && shx mkdir -p .build && yarn upgrade --pattern \"granite|strata\"",
        "build": "yarn run build-init && tsc && cd src/main/typescript && yarn run increment-snapshot && cd ../../.. && yarn run copy-files && cd .build/dist && yarn pack",
        "publish-package": "yarn run build && cd .build/dist && yarn publish --non-interactive --tag snapshot-1.0.0"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@mantine/core": "^7.17.0",
        "@mantine/hooks": "^7.17.0",
        "ag-grid-community": "^33.0.0",
        "ag-grid-react": "^33.0.0",
        "granite.frontendcontroller.client": "snapshot-1.0.0",
        "granite.frontendcontroller.service": "snapshot-1.0.0",
        "granite.web.authentication": "snapshot-1.0.0",
        "react": "^19.0.0",
        "react-router-dom": "^7.0.0",
        "strata.client.core": "release-1.0.0",
        "strata.foundation.core": "release-1.0.0",
        "strata.frontendcontroller.client": "release-1.0.0",
        "strata.frontendcontroller.service": "release-1.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.0.0",
        "del-cli": "^5.1.0",
        "npm-prerelease-timestamp": "^1.0.1",
        "shx": "^0.3.4",
        "typescript": "~6.0.2"
    }
}
